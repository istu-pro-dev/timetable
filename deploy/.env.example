# Copy to deploy/.env and adjust. Every variable has a default in docker-compose.yml,
# so the stack also starts without a .env file.

# PostgreSQL
POSTGRES_USER=timetable
POSTGRES_PASSWORD=timetable
POSTGRES_DB=timetable
# Host port for PostgreSQL (bound to 127.0.0.1), e.g. for `make dev` or psql.
POSTGRES_PORT=5432

# API (listens on :8080 inside the compose network)
# DATABASE_URL for the api container is built from the POSTGRES_* values above.
# For `make dev` (API on the host) use:
# DATABASE_URL=postgres://timetable:timetable@localhost:5432/timetable?sslmode=disable

# Auth. APP_ENV=dev (the compose default) allows an insecure built-in JWT secret and
# non-Secure cookies; for a real deployment use APP_ENV=production with a random JWT_SECRET
# (at least 32 bytes, e.g. `openssl rand -base64 48`).
APP_ENV=dev
JWT_SECRET=
# Secure attribute of the session cookies; defaults to true outside APP_ENV=dev.
COOKIE_SECURE=
# First admin, created on startup when no admin exists (ignored afterwards).
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Web (Caddy): host port serving the SPA and proxying /api/* to the api.
WEB_PORT=80
